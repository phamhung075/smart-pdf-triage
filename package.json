{
  "name": "pdf_triage",
  "version": "1.0.0",
  "description": "Local PDF Triage, Categorization, SQLite/JSON Registry, Web UI & FastMCP Server",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"*.db\" --exclude \"*.db-journal\" --exclude \"*.db-shm\" --exclude \"*.db-wal\" --exclude \"registry.json\" --exclude \"categories.json\" --exclude \"settings.json\" --exclude \"logs/**\" --exclude \".server.lock\" --exclude \".scan.lock\" src/index.ts",
    "start": "tsx watch --exclude \"*.db\" --exclude \"*.db-journal\" --exclude \"*.db-shm\" --exclude \"*.db-wal\" --exclude \"registry.json\" --exclude \"categories.json\" --exclude \"settings.json\" --exclude \"logs/**\" --exclude \".server.lock\" --exclude \".scan.lock\" src/index.ts",
    "desktop": "electron desktop/main.cjs",
    "dist:exe": "npx tsx -e \"import fs from 'fs'; try { fs.rmSync('dist-installer', { recursive: true, force: true }); } catch {}\" && electron-builder --win",
    "scan": "tsx src/index.ts scan",
    "mcp": "tsx src/index.ts mcp",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "pdf",
    "triage",
    "ollama",
    "mcp",
    "sqlite",
    "zod"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ollama": "^0.5.15",
    "pdf-parse": "^1.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/sqlite3": "^3.1.11",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@noble/hashes": "1.7.1"
  },
  "build": {
    "appId": "com.smartpdftriage.app",
    "productName": "Smart PDF Triage",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "dist/**/*",
      "src/**/*",
      "categories.json",
      "entity_dictionary.json",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "publish": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "differentialPackage": false
    }
  }
}
